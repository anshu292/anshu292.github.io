# Firebase client config (safe to expose in frontend — restrict via Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Neon (pulled by `npx neon checkout main` — never commit real values)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=main
# Optional: hosted API base for production (GitHub Pages has no Express server)
# Example: VITE_API_BASE_URL=https://your-api.example.com
VITE_API_BASE_URL=
