# Firebase client config (safe to expose in frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Neon (server-only — set these in Vercel Project → Settings → Environment Variables)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=main
API_PORT=3001

# Leave empty on Vercel (same-origin /api). Use only if API is on another host.
VITE_API_BASE_URL=
